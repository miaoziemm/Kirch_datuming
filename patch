+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  cat <<'EOF'
+Usage:
+  MODEL=vel.H OUT=full_wavefield.H FREQ=20 ./scripts/run_layer_wavefield_pipeline.sh
+
+Required environment variables:
+  MODEL                 Input 2-D SEP velocity model. Axis 1 is z, axis 2 is x.
+  OUT                   Output full complex wavefield SEP header.
+  FREQ                  Frequency in Hz.
+
+Optional environment variables:
+  DEPTHS                Comma-separated physical boundary depths below the model top.
+                        Use only when depth units are known to match the model reader.
+  DEPTH_INDICES         Comma-separated boundary z sample indices. If neither
+                        DEPTHS nor DEPTH_INDICES is set, these are generated.
+  LAYER_STEP_SAMPLES    Depth interval in z samples when DEPTH_INDICES is omitted [10].
+  WORKDIR               Directory for intermediate files [OUT directory/pipeline_FREQHz].
+  BIN_DIR               Directory containing built executables [build/bin].
+  USE_BF                Use butterfly Kirchhoff boundary extrapolation [1].
+  BF_P                  Butterfly interpolation order [12].
+  BF_N_LEAF             Butterfly leaf size [16].
+  BF_PANEL_LEVELS       Butterfly panel levels [1].
+  BF_AMP_EPS            Butterfly amplitude cutoff [1e-20].
+  BF_PHASE_TOL          Butterfly phase tolerance [2.0].
+  SRCX                  Source x coordinate [model center].
+  SRCZ                  Source z coordinate [model top].
+  VREF                  Reference velocity for Hankel initialization [model top center].
+  SPONGE                Lateral sponge width for dense Helmholtz fill [0].
+  SPONGE_STRENGTH       Lateral sponge strength [0.0].
+  HELMHOLTZ_DAMPING     Complex Helmholtz damping/shift [0.0].
+  MAX_DENSE_UNKNOWNS    Maximum dense unknowns per layer [20000].
+  KEEP_WORKDIR          Keep intermediate boundary file when set to 1 [1].
+
+Outputs:
+  OUT                   Complex wavefield volume with n1=2(real,imag), n2=nx,
+                        n3=nz when generated DEPTH_INDICES includes the model bottom.
+  WORKDIR/boundaries.H  Kirchhoff-propagated top and layer-boundary wavefields.
+
+Pipeline stages:
+  1) Parse model geometry and build/validate layer boundary sample indices/depths.
+  2) Run layer_kirchhoff_test. This computes per-layer traveltimes internally and
+     performs Kirchhoff extrapolation to produce boundary wavefields.
+  3) Run layer_wavefield_fill. This solves dense-direct per-layer Helmholtz
+     systems constrained by the boundary wavefields and writes the full field.
+EOF
+}
+
+if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
+  usage
+  exit 0
+fi
+
+: "${MODEL:?Need MODEL= input 2-D SEP velocity model}"
+: "${OUT:?Need OUT= output SEP header}"
+: "${FREQ:?Need FREQ= frequency in Hz}"
+
+BIN_DIR=${BIN_DIR:-build/bin}
+KIRCH=${KIRCH:-"${BIN_DIR}/layer_kirchhoff_test"}
+FILL=${FILL:-"${BIN_DIR}/layer_wavefield_fill"}
+
+if [[ ! -x "$KIRCH" ]]; then
+  echo "ERROR: missing executable $KIRCH. Build target layer_kirchhoff_test first." >&2
+  exit 1
+fi
+if [[ ! -x "$FILL" ]]; then
+  echo "ERROR: missing executable $FILL. Build target layer_wavefield_fill first." >&2
+  exit 1
+fi
+
+OUT_DIR=$(dirname "$OUT")
+if [[ "$OUT_DIR" == "." ]]; then
+  OUT_DIR=$(pwd)
+fi
+WORKDIR=${WORKDIR:-"${OUT_DIR}/pipeline_${FREQ}Hz"}
+mkdir -p "$WORKDIR"
+BOUNDARY=${BOUNDARY:-"${WORKDIR}/boundaries.H"}
+
+MODEL_GEOM=$(python3 - "$MODEL" <<'PY'
+import re
+import sys
+from pathlib import Path
+text = Path(sys.argv[1]).read_text(errors='ignore')
+def get(name, default=None):
+    m = re.search(r'(^|\s)' + re.escape(name) + r'\s*=\s*([^\s]+)', text)
+    if not m:
+        if default is None:
+            raise SystemExit(f"missing {name}= in {sys.argv[1]}")
+        return default
+    return m.group(2).strip('"')
+n1 = int(float(get('n1')))
+o1 = float(get('o1', '0'))
+d1 = float(get('d1'))
+n2 = int(float(get('n2')))
+o2 = float(get('o2', '0'))
+d2 = float(get('d2'))
+print(n1, o1, d1, n2, o2, d2)
+PY
+)
+read -r NZ OZ DZ NX OX DX <<<"$MODEL_GEOM"
+
+if [[ -n "${DEPTHS:-}" && -n "${DEPTH_INDICES:-}" ]]; then
+  echo "ERROR: set only one of DEPTHS or DEPTH_INDICES." >&2
+  exit 1
+fi
+
+DEPTH_PARAM_NAME=depth_indices
+if [[ -n "${DEPTHS:-}" ]]; then
+  DEPTH_PARAM_NAME=depths
+  DEPTH_PARAM_VALUE=${DEPTHS}
+else
+  LAYER_STEP_SAMPLES=${LAYER_STEP_SAMPLES:-10}
+  DEPTH_INDICES=${DEPTH_INDICES:-$(python3 - "$NZ" "$LAYER_STEP_SAMPLES" <<'PY'
+import sys
+nz = int(sys.argv[1])
+step = max(1, int(sys.argv[2]))
+idx = list(range(step, nz, step))
+if not idx or idx[-1] != nz - 1:
+    idx.append(nz - 1)
+print(','.join(str(i) for i in idx))
+PY
+)}
+  DEPTH_PARAM_VALUE=${DEPTH_INDICES}
+fi
+
+USE_BF=${USE_BF:-1}
+BF_P=${BF_P:-12}
+BF_N_LEAF=${BF_N_LEAF:-16}
+BF_PANEL_LEVELS=${BF_PANEL_LEVELS:-1}
+BF_AMP_EPS=${BF_AMP_EPS:-1e-20}
+BF_PHASE_TOL=${BF_PHASE_TOL:-2.0}
+SPONGE=${SPONGE:-0}
+SPONGE_STRENGTH=${SPONGE_STRENGTH:-0.0}
+HELMHOLTZ_DAMPING=${HELMHOLTZ_DAMPING:-0.0}
+MAX_DENSE_UNKNOWNS=${MAX_DENSE_UNKNOWNS:-20000}
+KEEP_WORKDIR=${KEEP_WORKDIR:-1}
+
+KIRCH_ARGS=(
+  "in=${MODEL}"
+  "out=${BOUNDARY}"
+  "${DEPTH_PARAM_NAME}=${DEPTH_PARAM_VALUE}"
+  "freq=${FREQ}"
+  "include_top=1"
+  "use_bf=${USE_BF}"
+  "bf_p=${BF_P}"
+  "bf_n_leaf=${BF_N_LEAF}"
+  "bf_panel_levels=${BF_PANEL_LEVELS}"
+  "bf_amp_eps=${BF_AMP_EPS}"
+  "bf_phase_tol=${BF_PHASE_TOL}"
+)
+[[ -n "${SRCX:-}" ]] && KIRCH_ARGS+=("srcx=${SRCX}")
+[[ -n "${SRCZ:-}" ]] && KIRCH_ARGS+=("srcz=${SRCZ}")
+[[ -n "${VREF:-}" ]] && KIRCH_ARGS+=("vref=${VREF}")
+
+FILL_ARGS=(
+  "model=${MODEL}"
+  "in=${BOUNDARY}"
+  "out=${OUT}"
+  "${DEPTH_PARAM_NAME}=${DEPTH_PARAM_VALUE}"
+  "freq=${FREQ}"
+  "sponge=${SPONGE}"
+  "sponge_strength=${SPONGE_STRENGTH}"
+  "helmholtz_damping=${HELMHOLTZ_DAMPING}"
+  "max_dense_unknowns=${MAX_DENSE_UNKNOWNS}"
+)
+
+echo "[1/3] Model geometry: nz=${NZ} oz=${OZ} dz=${DZ} nx=${NX} ox=${OX} dx=${DX}"
+if [[ "${DEPTH_PARAM_NAME}" == "depths" ]]; then
+  echo "[1/3] Boundary depths: ${DEPTH_PARAM_VALUE}"
+else
+  echo "[1/3] Boundary depth indices: ${DEPTH_PARAM_VALUE}"
+fi
+echo "[2/3] Kirchhoff boundary extrapolation -> ${BOUNDARY}"
+"$KIRCH" "${KIRCH_ARGS[@]}"
+echo "[3/3] Dense-direct Helmholtz layer fill -> ${OUT}"
+"$FILL" "${FILL_ARGS[@]}"
+
+if [[ "$KEEP_WORKDIR" != "1" ]]; then
+  rm -f "${BOUNDARY}" "${BOUNDARY}@"
+fi
+
+echo "Done. Full complex wavefield: ${OUT}"
