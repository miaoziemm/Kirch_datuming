+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)
+BIN_DIR=${BIN_DIR:-"${REPO_ROOT}/build/bin"}
+WORKDIR=${WORKDIR:-$(pwd)}
+MODEL=${MODEL:-"${WORKDIR}/layered_model.H"}
+OUT=${OUT:-"${WORKDIR}/freq_wavefield.H"}
+OUT_REAL=${OUT_REAL:-"${OUT}.real"}
+OUT_IMAG=${OUT_IMAG:-"${OUT}.imag"}
+TAU_PREFIX=${TAU_PREFIX:-"${WORKDIR}/tau_check"}
+BOUNDARY_PREFIX=${BOUNDARY_PREFIX:-"${WORKDIR}/boundary_field"}
+BLOCK_PREFIX=${BLOCK_PREFIX:-"${WORKDIR}/block_wavefield"}
+NX=${NX:-32}
+NZ=${NZ:-31}
+NLAYER=${NLAYER:-3}
+FREQS=${FREQS:-10,40,60}
+USE_BF=${USE_BF:-0}
+
+mkdir -p "$WORKDIR"
+"${BIN_DIR}/layered_model_gen" out="$MODEL" nx="$NX" nz="$NZ" dx=10 dz=10
+"${BIN_DIR}/layered_frequency_wavefield" model="$MODEL" out="$OUT" tau_prefix="$TAU_PREFIX" boundary_prefix="$BOUNDARY_PREFIX" block_prefix="$BLOCK_PREFIX" out_real="$OUT_REAL" out_imag="$OUT_IMAG" nlayer="$NLAYER" freqs="$FREQS" mode=source use_bf="$USE_BF" fpeak=30
+
+python3 - "$OUT" "$NX" "$NZ" "$FREQS" "$TAU_PREFIX" "$NLAYER" "$BOUNDARY_PREFIX" "$BLOCK_PREFIX" "$OUT_REAL" "$OUT_IMAG" <<'PY'
+import math
+import re
+import struct
+import sys
+from pathlib import Path
+out = Path(sys.argv[1])
+nx = int(sys.argv[2]); nz = int(sys.argv[3]); nf = len(sys.argv[4].split(','))
+tau_prefix = sys.argv[5]; nlayer = int(sys.argv[6])
+boundary_prefix = sys.argv[7]; block_prefix = sys.argv[8]
+out_real = Path(sys.argv[9]); out_imag = Path(sys.argv[10])
+text = out.read_text(errors='ignore')
+def get(name):
+    m = re.search(r'(^|\s)' + name + r'\s*=\s*([^\s]+)', text)
+    if not m:
+        raise SystemExit(f'missing {name}= in {out}')
+    return m.group(2).strip('"')
+assert int(float(get('n1'))) == 2
+assert int(float(get('n2'))) == nx
+assert int(float(get('n3'))) == nz
+assert int(float(get('n4'))) == nf
+data_name = get('in')
+data_path = Path(data_name)
+if not data_path.is_absolute():
+    data_path = out.parent / data_path
+raw = data_path.read_bytes()
+vals = struct.unpack('<%df' % (len(raw)//4), raw)
+expected = 2 * nx * nz * nf
+assert len(vals) == expected, (len(vals), expected)
+assert all(math.isfinite(v) for v in vals)
+assert math.sqrt(sum(v*v for v in vals)) > 0.0
+assert out_real.exists(), out_real
+assert out_imag.exists(), out_imag
+assert out_real.stat().st_size == 4 * nx * nz * nf
+assert out_imag.stat().st_size == 4 * nx * nz * nf
+def header_path(hdr, key):
+    h = hdr.read_text(errors='ignore')
+    m = re.search(key + r'="([^"]+)"', h)
+    assert m, (hdr, key)
+    d = Path(m.group(1))
+    if not d.is_absolute():
+        d = hdr.parent / d
+    return d
+def data_file(hdr):
+    return header_path(hdr, 'in')
+def split_files(hdr):
+    return header_path(hdr, 'in_real'), header_path(hdr, 'in_imag')
+for il in range(1, nlayer + 1):
+    hdr = Path(f'{tau_prefix}_layer{il:03d}.H')
+    assert hdr.exists(), hdr
