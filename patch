+#!/usr/bin/env python3
+"""Runtime validation for the dense-direct layer Helmholtz fill.
+
+The script generates small SEP velocity/boundary files, runs layer_wavefield_fill
+for several frequencies, grids, layer splits, and velocity models, and reports
+timing plus accuracy metrics. It intentionally avoids numpy so it can run in
+minimal CI/container environments.
+"""
+
+import argparse
+import cmath
+import math
+import pathlib
+import struct
+import subprocess
+import tempfile
+import time
+from typing import Callable, Dict, Iterable, List, Sequence, Tuple
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+BIN_FILL = ROOT / "build" / "bin" / "layer_wavefield_fill"
+
+
+def write_sep_header(path: pathlib.Path, axes: Sequence[Tuple[int, float, float]], data_name: str) -> None:
+    lines: List[str] = []
+    for iax, (n, o, d) in enumerate(axes, start=1):
+        lines.extend([f"n{iax}={n}", f"o{iax}={o}", f"d{iax}={d}"])
+    lines.extend(["esize=4", "data_format=native_float", f'in="{data_name}"'])
+    path.write_text("\n".join(lines) + "\n")
+
+
+def write_velocity(case_dir: pathlib.Path, nx: int, nz: int, dx: float, dz: float,
+                   vel_fn: Callable[[int, int], float]) -> pathlib.Path:
+    data = case_dir / "vel.H@"
+    with data.open("wb") as f:
+        for ix in range(nx):
+            for iz in range(nz):
+                f.write(struct.pack("<f", float(vel_fn(ix, iz))))
+    hdr = case_dir / "vel.H"
+    write_sep_header(hdr, [(nz, 0.0, dz), (nx, 0.0, dx)], data.name)
+    return hdr
+
+
+def boundary_value(z: float, freq: float, vref: float, model: str, ix: int, nx: int) -> complex:
+    omega = 2.0 * math.pi * freq
+    base = cmath.exp(-1j * omega * z / vref)
+    if model == "constant":
+        return base
+    taper = 1.0 + 0.15 * math.sin(2.0 * math.pi * ix / max(nx - 1, 1))
+    phase_x = 0.25 * math.sin(math.pi * ix / max(nx - 1, 1))
+    return taper * base * cmath.exp(1j * phase_x)
+
+
+def write_boundaries(case_dir: pathlib.Path, nx: int, dx: float, depths: Sequence[float],
+                     freq: float, vref: float, model: str) -> pathlib.Path:
+    data = case_dir / "bound.H@"
+    with data.open("wb") as f:
+        for z in depths:
+            for ix in range(nx):
+                u = boundary_value(z, freq, vref, model, ix, nx)
+                f.write(struct.pack("<ff", float(u.real), float(u.imag)))
+    hdr = case_dir / "bound.H"
+    d3 = depths[1] - depths[0] if len(depths) > 1 else 1.0
+    write_sep_header(hdr, [(2, 0.0, 1.0), (nx, 0.0, dx), (len(depths), depths[0], d3)], data.name)
+    return hdr
+
+
+def read_complex_field(data_path: pathlib.Path, nx: int, nzout: int) -> List[complex]:
+    raw = data_path.read_bytes()
+    vals = struct.unpack("<%df" % (len(raw) // 4), raw)
+    out: List[complex] = []
+    for iz in range(nzout):
+        for ix in range(nx):
+            off = (iz * nx + ix) * 2
+            out.append(complex(vals[off], vals[off + 1]))
+    return out
+
+
+def run_fill(case_dir: pathlib.Path, vel: pathlib.Path, bound: pathlib.Path,
+             depths_arg: str, freq: float, sponge: int, strength: float,
+             damping: float = 0.0) -> Tuple[float, str, pathlib.Path]:
+    out = case_dir / "full_dense_direct.H"
+    cmd = [
+        str(BIN_FILL), f"model={vel}", f"in={bound}", f"out={out}",
+        f"depths={depths_arg}", f"freq={freq}",
+        f"sponge={sponge}", f"sponge_strength={strength}", f"helmholtz_damping={damping}",
+    ]
+    start = time.perf_counter()
+    proc = subprocess.run(cmd, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    elapsed = time.perf_counter() - start
+    if proc.returncode != 0:
+        raise RuntimeError(f"{' '.join(cmd)} failed:\n{proc.stdout}")
+    return elapsed, proc.stdout, out
+
+
+def nonfinite_count(field: Sequence[complex]) -> int:
+    return sum(1 for u in field if not (math.isfinite(u.real) and math.isfinite(u.imag)))
+
+
+def analytic_metrics(field: Sequence[complex], nx: int, nzout: int, dz: float,
+                     freq: float, vref: float) -> Tuple[int, float, float, float]:
+    bad = nonfinite_count(field)
+    if bad:
+        return bad, float("nan"), float("nan"), float("nan")
+    max_amp = 0.0
+    max_phase = 0.0
+    rms = 0.0
+    n = 0
+    omega = 2.0 * math.pi * freq
+    for iz in range(nzout):
+        exact = cmath.exp(-1j * omega * (iz * dz) / vref)
+        for ix in range(nx):
+            got = field[iz * nx + ix]
+            rms += abs(got - exact) ** 2
+            max_amp = max(max_amp, abs(abs(got) - 1.0))
+            max_phase = max(max_phase, abs(math.atan2((got / exact).imag, (got / exact).real)))
+            n += 1
+    return bad, max_amp, max_phase, math.sqrt(rms / max(n, 1))
+
+
+def relative_l2(a: Sequence[complex], b: Sequence[complex]) -> float:
+    pairs = [(x, y) for x, y in zip(a, b)
+             if math.isfinite(x.real) and math.isfinite(x.imag) and math.isfinite(y.real) and math.isfinite(y.imag)]
+    if not pairs:
+        return float("nan")
+    num = math.sqrt(sum(abs(x - y) ** 2 for x, y in pairs))
+    den = math.sqrt(sum(abs(y) ** 2 for _, y in pairs))
+    return num / max(den, 1.0e-30)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--work-dir", default=None)
+    args = ap.parse_args()
+
+    if not BIN_FILL.exists():
+        raise SystemExit(f"Missing executable {BIN_FILL}; build layer_wavefield_fill first")
+
+    cases = [
+        {"name": "constant_f1_32x21_2layers", "nx": 32, "nz": 21, "dx": 10.0, "dz": 5.0, "freq": 1.0, "depths": [0.0, 50.0, 100.0], "model": "constant"},
+        {"name": "constant_f5_32x21_2layers", "nx": 32, "nz": 21, "dx": 10.0, "dz": 5.0, "freq": 5.0, "depths": [0.0, 50.0, 100.0], "model": "constant"},
+        {"name": "constant_f10_64x21_2layers", "nx": 64, "nz": 21, "dx": 10.0, "dz": 5.0, "freq": 10.0, "depths": [0.0, 50.0, 100.0], "model": "constant"},
+        {"name": "constant_f20_64x41_4layers", "nx": 64, "nz": 41, "dx": 10.0, "dz": 5.0, "freq": 20.0, "depths": [0.0, 50.0, 100.0, 150.0, 200.0], "model": "constant"},
+        {"name": "gradient_f10_64x41_4layers", "nx": 64, "nz": 41, "dx": 10.0, "dz": 5.0, "freq": 10.0, "depths": [0.0, 50.0, 100.0, 150.0, 200.0], "model": "gradient"},
+        {"name": "lens_f15_80x41_4layers", "nx": 80, "nz": 41, "dx": 8.0, "dz": 5.0, "freq": 15.0, "depths": [0.0, 50.0, 100.0, 150.0, 200.0], "model": "lens"},
+        {"name": "constant_f80_64x51_5layers", "nx": 64, "nz": 51, "dx": 2.0, "dz": 2.0, "freq": 80.0, "depths": [0.0, 20.0, 40.0, 60.0, 80.0, 100.0], "model": "constant"},
+        {"name": "lens_f80_64x51_5layers", "nx": 64, "nz": 51, "dx": 2.0, "dz": 2.0, "freq": 80.0, "depths": [0.0, 20.0, 40.0, 60.0, 80.0, 100.0], "model": "lens"},
+        {"name": "constant_f100_64x51_5layers", "nx": 64, "nz": 51, "dx": 2.0, "dz": 2.0, "freq": 100.0, "depths": [0.0, 20.0, 40.0, 60.0, 80.0, 100.0], "model": "constant"},
+        {"name": "lens_f100_64x51_5layers", "nx": 64, "nz": 51, "dx": 2.0, "dz": 2.0, "freq": 100.0, "depths": [0.0, 20.0, 40.0, 60.0, 80.0, 100.0], "model": "lens"},
+    ]
+
+    vref = 2000.0
+    root = pathlib.Path(args.work_dir) if args.work_dir else pathlib.Path(tempfile.mkdtemp(prefix="layer_fill_bench_"))
+    root.mkdir(parents=True, exist_ok=True)
+    print(f"work_dir={root}")
+    print("case,elapsed_s,samples,nonfinite,max_amp_error,max_phase_error_rad,rms")
+
+    for case in cases:
+        case_dir = root / case["name"]
+        case_dir.mkdir(parents=True, exist_ok=True)
+        nx = int(case["nx"]); nz = int(case["nz"]); dx = float(case["dx"]); dz = float(case["dz"])
+        freq = float(case["freq"]); depths = list(case["depths"]); model = str(case["model"])
+
+        def vel_fn(ix: int, iz: int) -> float:
+            if model == "constant":
+                return vref
+            if model == "gradient":
+                return 1800.0 + 1.5 * iz * dz + 80.0 * math.sin(2.0 * math.pi * ix / max(nx - 1, 1))
+            cx = 0.5 * (nx - 1); cz = 0.55 * (nz - 1)
+            r2 = ((ix - cx) / (0.22 * nx)) ** 2 + ((iz - cz) / (0.25 * nz)) ** 2
+            return 2000.0 - 260.0 * math.exp(-r2) + 0.8 * iz * dz
+
+        vel = write_velocity(case_dir, nx, nz, dx, dz, vel_fn)
+        bound = write_boundaries(case_dir, nx, dx, depths, freq, vref, model)
+        depths_arg = ",".join(str(d) for d in depths)
+        nzout = int(round((depths[-1] - depths[0]) / dz)) + 1
+
+        damping = 0.02 if freq >= 60.0 else 0.0
+        dense_t, _, dense_out = run_fill(case_dir, vel, bound, depths_arg, freq, 0, 0.0, damping)
+        dense = read_complex_field(dense_out.with_name(dense_out.name + "@"), nx, nzout)
+        if model == "constant":
+            bad, max_amp, max_phase, metric = analytic_metrics(dense, nx, nzout, dz, freq, vref)
+        else:
+            bad = nonfinite_count(dense)
+            max_amp = float("nan")
+            max_phase = float("nan")
+            metric = float("nan")
+        print(f"{case['name']},{dense_t:.6f},{len(dense)*2},{bad},{max_amp:.6g},{max_phase:.6g},{metric:.6g}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
