+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+    cat <<'EOF'
+Usage:
+  scripts/benchmark_block_iterative.sh VELOCITY_RSF [OUTPUT_DIR] [BIN_DIR]
+
+The script compares serial sewave2d FD8 modeling with the FMM-initialized
+equal-block Robin down/up solver. It reports median wall time, maximum RSS,
+and the relative L2/max-absolute record difference through rsf_l2cmp.
+
+Important environment overrides:
+  NT=2000 DT=0.0005 FDOM=15
+  SX=... SZ=... RZ=... NS=1 DS=0
+  BLOCKS=4 OVERLAP=22 CYCLES=1 BETA=1.0 GATE=0.003
+  NBC=40 L=30 ALPHA=1
+  REPEATS=3 WARMUP=1
+
+BIN_DIR must contain sewave2d, block_iterative_forward, and rsf_l2cmp.
+EOF
+}
+
+if [[ $# -lt 1 || $# -gt 3 ]]; then
+    usage
+    exit 2
+fi
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
+VELOCITY=$1
+OUTPUT_DIR=${2:-"${REPO_ROOT}/benchmark_block_iterative"}
+BIN_DIR=${3:-"${REPO_ROOT}/build/bin"}
+
+SEWAVE="${BIN_DIR}/sewave2d"
+BLOCK_FORWARD="${BIN_DIR}/block_iterative_forward"
+RSF_COMPARE="${BIN_DIR}/rsf_l2cmp"
+
+for executable in "${SEWAVE}" "${BLOCK_FORWARD}" "${RSF_COMPARE}"; do
+    if [[ ! -x "${executable}" ]]; then
+        echo "Missing executable: ${executable}" >&2
+        echo "Build targets sewave2d, block_iterative_forward, and rsf_l2cmp first." >&2
+        exit 2
+    fi
+done
+if [[ ! -f "${VELOCITY}" ]]; then
+    echo "Velocity RSF header not found: ${VELOCITY}" >&2
+    exit 2
+fi
+TIME_BIN=${TIME_BIN:-/usr/bin/time}
+if [[ -x "${TIME_BIN}" ]]; then
+    HAVE_GNU_TIME=1
+else
+    HAVE_GNU_TIME=0
+    echo "GNU time not found; wall time will be measured, max_rss_kib will be -1." >&2
+fi
+
+mkdir -p "${OUTPUT_DIR}"
+
+NT=${NT:-2000}
+DT=${DT:-0.0005}
+FDOM=${FDOM:-15}
+NS=${NS:-1}
+DS=${DS:-0}
+BLOCKS=${BLOCKS:-4}
+OVERLAP=${OVERLAP:-22}
+CYCLES=${CYCLES:-1}
+BETA=${BETA:-1.0}
+GATE=${GATE:-0.003}
+NBC=${NBC:-40}
+L=${L:-30}
+ALPHA=${ALPHA:-1}
+REPEATS=${REPEATS:-3}
+WARMUP=${WARMUP:-1}
+
+export OMP_NUM_THREADS=1
+export OMP_DYNAMIC=FALSE
+export OPENBLAS_NUM_THREADS=1
+export MKL_NUM_THREADS=1
+export VECLIB_MAXIMUM_THREADS=1
+export NUMEXPR_NUM_THREADS=1
+
+REFERENCE_RECORD="${OUTPUT_DIR}/sewave_fd8.rsf"
+BLOCK_RECORD="${OUTPUT_DIR}/block_iterative_fd8.rsf"
+RAY_RECORD="${OUTPUT_DIR}/fmm_ray_initial.rsf"
+TRAVEL_TIME="${OUTPUT_DIR}/fmm_traveltime.rsf"
+
+common_args=(
+    "velocity=${VELOCITY}"
+    "nt=${NT}"
+    "dt=${DT}"
+    "fdom=${FDOM}"
+    "ns=${NS}"
+    "ds=${DS}"
+    "nbc=${NBC}"
+    "L=${L}"
+    "alpha=${ALPHA}"
+    "progress_interval=0"
+)
+if [[ -n "${SX:-}" ]]; then common_args+=("sx=${SX}"); fi
+if [[ -n "${SZ:-}" ]]; then common_args+=("sz=${SZ}"); fi
+if [[ -n "${RZ:-}" ]]; then common_args+=("rz=${RZ}"); fi
+
+sewave_args=(
+    "mode=forward"
+    "output=${REFERENCE_RECORD}"
+    "type_compute_Laplace=0"
+    "visco=0"
+    "flag_smooth=0"
+    "${common_args[@]}"
+)
+block_args=(
+    "output=${BLOCK_RECORD}"
+    "ray_output=${RAY_RECORD}"
+    "blocks=${BLOCKS}"
+    "overlap=${OVERLAP}"
+    "cycles=${CYCLES}"
+    "beta=${BETA}"
+    "gate=${GATE}"
+    "${common_args[@]}"
+)
+if [[ "${NS}" -eq 1 ]]; then
+    block_args+=("traveltime=${TRAVEL_TIME}")
+fi
+if [[ -n "${RAY_SCALE:-}" ]]; then
+    block_args+=("ray_scale=${RAY_SCALE}")
+fi
+
+run_once() {
+    local label=$1
+    local timing_file=$2
+    shift 2
+    if [[ "${HAVE_GNU_TIME}" -eq 1 ]]; then
+        "${TIME_BIN}" -f '%e,%M' -o "${timing_file}" "$@" \
+            >"${OUTPUT_DIR}/${label}.log" 2>&1
+    else
+        local begin_ns
+        local end_ns
+        local elapsed
+        begin_ns=$(date +%s%N)
+        "$@" >"${OUTPUT_DIR}/${label}.log" 2>&1
+        end_ns=$(date +%s%N)
+        elapsed=$(awk -v begin="${begin_ns}" -v end="${end_ns}" \
+            'BEGIN { printf "%.9f", (end - begin) / 1.0e9 }')
+        printf '%s,-1\n' "${elapsed}" >"${timing_file}"
+    fi
+}
+
+if [[ "${WARMUP}" -ne 0 ]]; then
+    run_once warmup_sewave "${OUTPUT_DIR}/warmup_sewave.time" \
+        "${SEWAVE}" "${sewave_args[@]}"
+    run_once warmup_block "${OUTPUT_DIR}/warmup_block.time" \
+        "${BLOCK_FORWARD}" "${block_args[@]}"
+fi
+
+: >"${OUTPUT_DIR}/sewave_times.csv"
+: >"${OUTPUT_DIR}/block_times.csv"
+for ((run = 1; run <= REPEATS; ++run)); do
+    run_once "sewave_run_${run}" "${OUTPUT_DIR}/sewave_run_${run}.time" \
+        "${SEWAVE}" "${sewave_args[@]}"
+    cat "${OUTPUT_DIR}/sewave_run_${run}.time" \
+        >>"${OUTPUT_DIR}/sewave_times.csv"
+
+    run_once "block_run_${run}" "${OUTPUT_DIR}/block_run_${run}.time" \
+        "${BLOCK_FORWARD}" "${block_args[@]}"
+    cat "${OUTPUT_DIR}/block_run_${run}.time" \
+        >>"${OUTPUT_DIR}/block_times.csv"
+done
+
+median_column() {
+    local file=$1
+    local column=$2
+    awk -F, -v column="${column}" '{print $column}' "${file}" |
+        sort -n |
+        awk '
+            { value[NR] = $1 }
+            END {
+                if (NR % 2 == 1) print value[(NR + 1) / 2];
+                else print 0.5 * (value[NR / 2] + value[NR / 2 + 1]);
+            }'
+}
+
+maximum_column() {
+    local file=$1
+    local column=$2
+    awk -F, -v column="${column}" '
+        NR == 1 || $column > maximum { maximum = $column }
+        END { print maximum }' "${file}"
+}
+
+SEWAVE_SECONDS=$(median_column "${OUTPUT_DIR}/sewave_times.csv" 1)
+BLOCK_SECONDS=$(median_column "${OUTPUT_DIR}/block_times.csv" 1)
+SEWAVE_RSS_KIB=$(maximum_column "${OUTPUT_DIR}/sewave_times.csv" 2)
+BLOCK_RSS_KIB=$(maximum_column "${OUTPUT_DIR}/block_times.csv" 2)
+RATIO=$(awk -v block="${BLOCK_SECONDS}" -v reference="${SEWAVE_SECONDS}" \
+    'BEGIN { if (reference > 0) printf "%.6f", block / reference; else print "nan" }')
+
+COMPARE_OUTPUT=$("${RSF_COMPARE}" "a=${BLOCK_RECORD}" "b=${REFERENCE_RECORD}")
+printf '%s\n' "${COMPARE_OUTPUT}" >"${OUTPUT_DIR}/record_difference.txt"
+
+{
+    echo "method,median_wall_seconds,max_rss_kib"
+    echo "sewave_fd8,${SEWAVE_SECONDS},${SEWAVE_RSS_KIB}"
+    echo "fmm_block_robin_fd8,${BLOCK_SECONDS},${BLOCK_RSS_KIB}"
+} >"${OUTPUT_DIR}/benchmark_metrics.csv"
+
+{
+    echo "Serial forward-modeling benchmark"
+    echo "velocity=${VELOCITY}"
+    echo "nt=${NT} dt=${DT} fdom=${FDOM} ns=${NS} ds=${DS}"
+    echo "blocks=${BLOCKS} overlap=${OVERLAP} cycles=${CYCLES} beta=${BETA} gate=${GATE}"
+    echo "nbc=${NBC} L=${L} alpha=${ALPHA} repeats=${REPEATS}"
+    echo "sewave_median_seconds=${SEWAVE_SECONDS}"
+    echo "block_median_seconds=${BLOCK_SECONDS}"
+    echo "block_over_sewave_time_ratio=${RATIO}"
+    echo "sewave_max_rss_kib=${SEWAVE_RSS_KIB}"
+    echo "block_max_rss_kib=${BLOCK_RSS_KIB}"
+    echo "${COMPARE_OUTPUT}"
+} >"${OUTPUT_DIR}/benchmark_summary.txt"
+
+cat "${OUTPUT_DIR}/benchmark_summary.txt"
