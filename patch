 std::vector<int> parse_int_list(const char* text) {
     std::vector<int> values;
     if (!text) return values;
     std::stringstream ss(text);
     std::string item;
     while (std::getline(ss, item, ',')) {
         if (!item.empty()) values.push_back(std::max(1, std::atoi(item.c_str())));
